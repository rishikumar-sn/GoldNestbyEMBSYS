APP_ENV=development
HOST=0.0.0.0
PORT=8443
DATABASE_URL=sqlite:///runtime/database/goldnest.sqlite3
STORAGE_ROOT=runtime/storage
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key
YOLOE_MODEL=models/yoloe/yoloe-26s-seg.pt
YOLOE_DEVICE=auto
YOLOE_PROMPTS=jewelry,gold jewelry,bangle,earring,ring,necklace
YOLOE_CONFIDENCE=0.15
VISUAL_PROMPTS_ENABLED=true
VISUAL_PROMPT_CONFIDENCE=0.08
INSPYRENET_MODEL=models/inspyrenet/ckpt_fast.pth
INSPYRENET_DEVICE=cpu
INSPYRENET_ENABLED=true
SIGLIP_MODEL_DIR=models/siglip2
SIGLIP_PROVIDER=auto
CORRECTION_GALLERY_PATH=runtime/model_state/jewelry_correction_gallery.npz
KEEP_UPLOADS=true
RETENTION_DAYS=0
DISPLAY_TIMEZONE=Asia/Kolkata
